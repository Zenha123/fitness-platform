DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Phase 1 Task 1 decisions ---
# Video conferencing: zoom | google_meet
VIDEO_PROVIDER=zoom
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Email: console (local) | sendgrid (production via SMTP)
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=noreply@haqqathlete.com
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20
# Optional override for trainer booking alerts (defaults to trainer account email)
TRAINER_NOTIFY_EMAIL=

# Production frontend origin (no trailing slash). Auto-added to CORS if missing.
FRONTEND_BASE_URL=http://localhost:5173

# Trainer timezone (IANA). Availability hours / trainer emails use this zone.
TRAINER_TIMEZONE=Asia/Kolkata

# Shown in client confirmation emails (Phase 1 §5.5)
BOOKING_CANCELLATION_POLICY=Please cancel or reschedule at least 24 hours before your session by replying to this email. Late cancellations may forfeit the session.
